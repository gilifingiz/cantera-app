rules_version = '2';

// Drivers work WITHOUT an account (they scan in and record trips on shared
// devices), so reads/creates/updates stay open for the viajes collection.
// Deleting trips is admin-only: requires a signed-in user whose email is on
// the admin allowlist below. Update the allowlist and redeploy when the
// admin account changes.
service cloud.firestore {
  match /databases/{database}/documents {
    match /viajes/{viajeId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null
        && request.auth.token.email == 'giuli10.carte@gmail.com';
    }
  }
}